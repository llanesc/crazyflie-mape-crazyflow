{
    "ROS2.distro": "jazzy",
    "python.autoComplete.extraPaths": [
        "/opt/ros/jazzy/lib/python3.12/site-packages"
    ],
    "python.analysis.extraPaths": [
        "/opt/ros/jazzy/lib/python3.12/site-packages"
    ],
    "files.exclude": {
        "env_crazyflow/**": true,
        "env_hardware/**": true,
        "results/**/*.pt": true,
        "results/**/events.out.tfevents*": true
    },
    "files.watcherExclude": {
        "results/**/*.pt": true,
        "results/**/events.out.tfevents*": true
    },
    "search.exclude": {
        "results/**/*.pt": true,
        "results/**/events.out.tfevents*": true
    }
}